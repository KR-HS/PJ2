<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//MyBatis//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pieum.user.model.UserMapper">

    <!-- 사용자 추가 -->
    <insert id="registAdmin" parameterType="pieum.user.model.UserDTO">
        INSERT INTO MEMBER (mno, mid, mpw, mname, gender, birth, phone)
        VALUES (CONCAT(#{mno},ADMIN_SEQ.NEXTVAL), #{mid}, #{mpw}, #{mname}, #{gender}, #{birth}, #{phone})
    </insert>
    
    <insert id="registUser" parameterType="pieum.user.model.UserDTO">
        INSERT INTO MEMBER (mno, mid, mpw, mname, gender, birth, phone)
        VALUES (CONCAT(#{mno},USER_SEQ.NEXTVAL), #{mid}, #{mpw}, #{mname}, #{gender}, #{birth}, #{phone})
    </insert>

    <!-- 사용자 조회 (mno 기준) -->
    <select id="selectUserByMno" resultType="pieum.user.model.UserDTO">
        SELECT mno, mid, mpw, mname, gender, birth, phone
        FROM MEMBER
        WHERE mno = #{mno}
    </select>

    <!-- 사용자 조회 (mid 기준) -->
    <select id="selectUserByMid" resultType="pieum.user.model.UserDTO">
        SELECT mno, mid, mpw, mname, gender, birth, phone
        FROM MEMBER
        WHERE mid = #{mid}
    </select>

    <!-- 사용자 수정 -->
    <update id="updateUser" parameterType="pieum.user.model.UserDTO">
        UPDATE MEMBER
        SET mid = #{mid}, mpw = #{mpw}, mname = #{mname}, gender = #{gender}, birth = #{birth}, phone = #{phone}
        WHERE mno = #{mno}
    </update>

    <!-- 사용자 삭제 (mno 기준) -->
    <delete id="deleteUser" parameterType="String">
        DELETE FROM MEMBER
        WHERE mno = #{mno}
    </delete>

    <!-- 모든 사용자 조회 -->
    <select id="selectAllUsers" resultType="pieum.user.model.UserDTO">
        SELECT mno, mid, mpw, mname, gender, birth, phone
        FROM MEMBER
    </select>

</mapper>
