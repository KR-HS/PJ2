		System.out.println(111);
		UserDTO dto = new UserDTO(userType,id,pw,name,gender,birth,phone);
		System.out.println(111);
		int result=0;
		
		
		if(userType.equals("m")) result= user.registAdmin(dto);
		else result = user.registUser(dto);
		System.out.println(111);
		sql.close();
		// System.out.println(result);
		response.sendRedirect("home.jsp");
		
	}

